{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Craftag",
  "version": "1.1.2",
  "identifier": "com.craftag.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Craftag",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "../license.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
